# Copy to mobile/.env (gitignored). Same values as the web store's .env:
#   VITE_SUPABASE_URL      → EXPO_PUBLIC_SUPABASE_URL
#   VITE_SUPABASE_ANON_KEY → EXPO_PUBLIC_SUPABASE_ANON_KEY
# EXPO_PUBLIC_ values are bundled into the app, so only public keys go here —
# never the service role key or the Resend key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_STORAGE_BUCKET=product-images

# The deployed web store on Vercel, e.g. https://dariy-bloom.vercel.app
# Used for product photos in public/images and for /api/send-order-email.
EXPO_PUBLIC_SITE_URL=
