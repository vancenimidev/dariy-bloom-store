# Supabase (optional) — leave blank to run the store fully offline.
# Find these in Supabase Dashboard → Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: endpoint that sends the order confirmation email (e.g. the
# Supabase Edge Function in supabase/functions/send-order-email).
# When blank, the email is simulated and logged to the browser console.
VITE_ORDER_EMAIL_ENDPOINT=
