# ── Storefront (browser) — safe to expose ───────────────────────────────────
# Supabase (optional) — leave blank to run the store fully offline.
# Supabase Dashboard → Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Public Storage bucket for product photos (used for image paths that aren't
# full URLs or /images/... files). Defaults to "product-images".
VITE_SUPABASE_STORAGE_BUCKET=product-images

# Confirmation emails: set to /api/send-order-email to send through Mailgun.
# Leave blank to simulate (the email is logged to the browser console).
VITE_ORDER_EMAIL_ENDPOINT=

# ── Server only (api/send-order-email.js) — NEVER prefix with VITE_ ─────────
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# Optional:
MAILGUN_FROM="Dariy Bloom <orders@your-mailgun-domain>"
# MAILGUN_API_BASE=https://api.eu.mailgun.net   # only for EU-region Mailgun domains
SUPABASE_SERVICE_ROLE_KEY=
