# ── Storefront (browser) — safe to expose ───────────────────────────────────
# Supabase (optional) — leave blank to run the store fully offline.
# Supabase Dashboard → Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Public Storage bucket for product photos (used for image paths that aren't
# full URLs or /images/... files). Defaults to "product-images".
VITE_SUPABASE_STORAGE_BUCKET=product-images

# Confirmation emails go to /api/send-order-email by default. Only set this
# if the email function is hosted somewhere else.
# VITE_ORDER_EMAIL_ENDPOINT=

# ── Server only (api/send-order-email.js) — NEVER prefix with VITE_ ─────────
RESEND_API_KEY=
# Optional; the domain must be verified in Resend. Defaults to onboarding@resend.dev.
RESEND_FROM="Dariy Bloom <orders@dariybloom.com>"
SUPABASE_SERVICE_ROLE_KEY=
